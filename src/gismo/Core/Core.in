/** @file Core

    @brief Main GISMO Core module header - includes all Core functionality

    This header provides access to all Core module components:
    - Function layer: Function interfaces and evaluation
    - Basis layer: Basis function abstractions
    - Topology layer: Connectivity and boundary management
    - Geometry layer: Geometric objects and shapes (unified)
    - SpecializedFunction layer: Advanced function types
    - DOFMapping layer: Degree of freedom management
    - MultiPatch layer: Multi-patch operations
    - Field layer: Field definitions and operations
    - Mesh layer: Mesh structures and operations
    - Utilities layer: Core support utilities

    Usage:
    @code
    #include <gismo/Core/Core>

    // Access all Core functionality
    gismo::gsFunctionSet<real_t> fs;
    gismo::gsBasis<real_t> basis;
    gismo::gsGeometry<real_t> geom;
    @endcode
*/

#pragma once

// Foundation dependencies
#include <gismo/Common/Common>
#include <gismo/Math/Math>

// Function layer
#include <gismo/Core/Function/FunctionSet.h>
#include <gismo/Core/Function/Function.h>
#include <gismo/Core/Function/FuncData.h>
#include <gismo/Core/Function/FuncCoordinate.h>

// Topology layer
#include <gismo/Core/Topology/Boundary.h>
#include <gismo/Core/Topology/BoxTopology.h>

// Basis layer
#include <gismo/Core/Basis/Basis.h>
#include <gismo/Core/Basis/BasisFun.h>
#include <gismo/Core/Basis/BasisRefs.h>
#include <gismo/Core/Basis/ConstantBasis.h>
#include <gismo/Core/Basis/RationalBasis.h>
#include <gismo/Core/Basis/ComposedBasis.h>

// Geometry layer (unified - includes geometric shapes)
#include <gismo/Core/Geometry/Geometry.h>
#include <gismo/Core/Geometry/Curve.h>
#include <gismo/Core/Geometry/Surface.h>
#include <gismo/Core/Geometry/Volume.h>
#include <gismo/Core/Geometry/Bulk.h>
#include <gismo/Core/Geometry/GenericGeometry.h>
#include <gismo/Core/Geometry/GeometrySlice.h>

// SpecializedFunction layer
#include <gismo/Core/SpecializedFunction/AffineFunction.h>
#include <gismo/Core/SpecializedFunction/FunctionExpr.h>
#include <gismo/Core/SpecializedFunction/ComposedFunction.h>
#include <gismo/Core/SpecializedFunction/ConstantFunction.h>
#include <gismo/Core/SpecializedFunction/PiecewiseFunction.h>
#include <gismo/Core/SpecializedFunction/PatchwiseFunction.h>
#include <gismo/Core/SpecializedFunction/GeometryTransform.h>
#include <gismo/Core/SpecializedFunction/ComposedGeometry.h>

// DOFMapping layer
#include <gismo/Core/DOFMapping/DofMapper.h>

// MultiPatch layer
#include <gismo/Core/MultiPatch/MultiPatch.h>
#include <gismo/Core/MultiPatch/MultiBasis.h>

// Field layer
#include <gismo/Core/Field/Field.h>
#include <gismo/Core/Field/FieldCreator.h>

// Mesh layer
#include <gismo/Core/Mesh/Mesh.h>
#include <gismo/Core/Mesh/HalfEdgeMesh.h>

// Utilities layer
#include <gismo/Core/Utilities/JITCompiler.h>
#include <gismo/Core/Utilities/SysInfo.h>